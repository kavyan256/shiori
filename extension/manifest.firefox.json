{
  "manifest_version": 3,
  "name": "Shiori",
  "version": "0.8.0",
  "description": "Lets the Shiori desktop app see your tabs when you save your desk, and reopen them as a named tab group when you resume. Remembers where you were in YouTube videos.",
  "permissions": ["tabs", "tabGroups", "alarms", "scripting"],
  "host_permissions": ["http://127.0.0.1:47321/*", "https://www.youtube.com/*"],
  "background": { "scripts": ["background.js"] },
  "icons": { "128": "icon128.png" },
  "browser_specific_settings": {
    "gecko": {
      "id": "shiori@kavyan256.github.io",
      "strict_min_version": "139.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
